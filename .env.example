# ==========================================
# Variáveis de Ambiente - TelemedAI Platform
# ==========================================
# Copie este ficheiro para '.env' na raiz do projeto e substitua pelos seus valores reais.

# Google Gemini API Key (Necessário para a IA de triagem e co-pilot clínico)
# Obtenha uma chave em: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Porta do Servidor Backend (Padrão: 3000)
PORT=3000

# URL do Servidor / Aplicação
APP_URL="http://localhost:3000"

# ==========================================
# Configurações do Supabase (Opcional para produção)
# ==========================================
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Variáveis expostas ao Frontend Vite
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Variáveis expostas a Frameworks do Ecossistema (Next.js / Vercel)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key_here"
